# The village server (port 8262), behind the droplet's reverse proxy.
# Confirmed 2026-08-26: the droplet runs systemd (the swarm services set the
# pattern) and Caddy, not nginx — use deploy/village.Caddyfile as the vhost.
#
# Install:
#   sudo cp deploy/skill-village.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now skill-village

[Unit]
Description=Skill Village server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=village
Group=village
WorkingDirectory=/srv/skill-village

# 127.0.0.1 keeps the node process off the public interface — nginx is the
# only way in. An EMPTY VILLAGE_HOST also stays on loopback (see 18b5f4b);
# this states it rather than relying on that.
Environment=NODE_ENV=production
Environment=VILLAGE_HOST=127.0.0.1
Environment=VILLAGE_PORT=8262

# The droplet's Caddy has no rate-limit module, so the server itself carries
# the public-LLM guard (6 r/min + burst 3 per client — the one guard the
# fully-public posture keeps; see AppOptions in packages/server/src/api/app.ts).
Environment=VILLAGE_LLM_RPM=6
Environment=VILLAGE_LLM_BURST=3

# The droplet has none of the owner's skill or agent files. Without snapshot
# mode the boot-time reconcile releases every seeded villager on arrival, and
# the public /api/refresh route would let anyone do the same.
Environment=VILLAGE_SNAPSHOT=1

ExecStart=/usr/bin/npx tsx packages/server/src/main.ts

Restart=always
RestartSec=3

# State lives in ~village/.skill-village (resolvePaths, config/paths.ts):
# state.json, its backup, events.jsonl, shadow/ and archive/. It must
# survive restarts and redeploys, so it is deliberately outside the checkout.
StateDirectory=skill-village

[Install]
WantedBy=multi-user.target
